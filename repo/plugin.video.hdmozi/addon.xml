<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.hdmozi"
       name="Rombi TV"
       version="1.1.7"
       provider-name="OpenCode">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="hu">Rombi TV Kodi videó bővítmény</summary>
        <description lang="hu">Rombi TV online videós tartalmak böngészéséhez Kodi alatt.</description>
        <platform>all</platform>
        <language>hu</language>
        <assets>
            <icon>logo.png</icon>
        </assets>
    </extension>
</addon>
