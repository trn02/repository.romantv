<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
    <addon id="repository.romantv" name="RomanTV Repository" version="1.0.0" provider-name="RomanTV">
        <extension point="xbmc.addon.repository" name="RomanTV Repository">
            <dir>
                <info compressed="false">https://trn02.github.io/repository.romantv/repo/addons.xml</info>
                <checksum>https://trn02.github.io/repository.romantv/repo/addons.xml.md5</checksum>
                <datadir zip="true">https://trn02.github.io/repository.romantv/repo/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="hu_HU">RomanTV Kodi tároló</summary>
            <description lang="hu_HU">RomanTV Kodi repository GitHub Pages kiszolgálással.</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
    <addon id="plugin.video.hdmozi" name="Rombi TV" version="1.1.8" provider-name="OpenCode">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="service.py" start="startup" />
        <extension point="xbmc.addon.metadata">
            <summary lang="hu">Rombi TV Kodi videó bővítmény</summary>
            <description lang="hu">Rombi TV online videós tartalmak böngészéséhez Kodi alatt.</description>
            <platform>all</platform>
            <language>hu</language>
            <assets>
                <icon>logo.png</icon>
            </assets>
        </extension>
    </addon>
</addons>
